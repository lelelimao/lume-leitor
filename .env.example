# Copie para .env. Nunca compartilhe seu token do Home Assistant.
VISION_MODE=yolo_ocr
YOLO_MODEL_PATH=models/yolo11n-text.pt
OCR_LANGUAGES=por+eng
USE_GPU=false
# Deixe vazio para detectar tools/tesseract ou a instalação do Windows.
TESSERACT_CMD=

# Opcionais: Alexa em um Echo por Home Assistant + Alexa Media Player.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
ALEXA_ENTITY_ID=

# Opcional: expressoes oficiais do Azure Speech; configure tambem pela interface.
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=

# Opcional: análise de fotos com Gemini. Configure também pela interface.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Exemplos de valores (não habilitam a integração):
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# ALEXA_ENTITY_ID=media_player.echo_da_sala
